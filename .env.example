# Lume V2.0 Environment Configuration
# Copie para .env e personalize conforme necessário

# === BASIC SETTINGS ===
LUME_TIMEOUT=10.0
LUME_VERIFY_TLS=true
LUME_LOG_LEVEL=INFO

# === RECONNAISSANCE ===
LUME_NMAP=true
LUME_NMAP_ARGS=-p 80,443,8080,8443 -sV --script vuln

# === BROWSER ===
LUME_PLAYWRIGHT=true
LUME_BROWSER_TYPE=chromium
LUME_HEADLESS=true

# === SECURITY ===
LUME_FUZZING=true
LUME_FUZZING_DEPTH=aggressive

# === SSL/TLS ===
LUME_MIN_TLS_VERSION=1.2

# === REPORTING ===
LUME_REPORT_FORMAT=html
LUME_REPORT_INCLUDE_REMEDIATION=true

# === PERFORMANCE ===
LUME_WORKERS=4
LUME_ENABLE_ASYNC=true

# === WAF ===
LUME_WAF_DETECTION=true

# === OWASP ZAP (optional) ===
# LUME_ZAP=false
# LUME_ZAP_URL=http://localhost:8080
